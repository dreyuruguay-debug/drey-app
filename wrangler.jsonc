// Configuración de la publicación en Cloudflare (la usa "npx wrangler
// deploy" después de construir la web). Le dice a Cloudflare que publique
// la carpeta "dist" como una web de una sola página (React): cualquier
// dirección (/inicio, /rutinas...) abre la app. No hace falta tocarlo.
{
  "name": "drey-app",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
