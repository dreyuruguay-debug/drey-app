# Modelo de las variables de la app. NO poner claves acá: este archivo se
# sube a GitHub. Las de verdad se cargan en Cloudflare (Settings →
# Variables) y, si alguna vez se corre la app en la compu, en un archivo
# ".env" con estos mismos nombres (ese sí queda fuera de GitHub).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=la-clave-anon-publica

# Opcional: aviso de errores por mail (Sentry). Vacío = no se usa.
VITE_SENTRY_DSN=

# Opcional: número de versión que se ve en Perfil.
VITE_VERSION=
